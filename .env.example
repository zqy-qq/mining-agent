# DeepSeek API Key（必填，去 https://platform.deepseek.com 申请，5 分钟搞定）
# 1. 用手机号注册 DeepSeek 账号
# 2. 进入"API Keys"页面，创建新 key
# 3. 把 key 复制到下面（去掉引号和注释）
DEEPSEEK_API_KEY=

# DeepSeek 模型名（默认 deepseek-chat，按需切换）
DEEPSEEK_MODEL=deepseek-chat

# 模型调用参数（可选）
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=2000

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
